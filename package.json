{
	"type": "module",
	"name": "books-collection-app",
	"version": "1.0.0",
	"description": "A simple RESTful API server in Node.js for the book collection app. Each book has a title, description, and 1-n authors. API endpoints allows searching in collection and book management (CRUD)",
	"main": "app.js",
	"scripts": {
		"start": "node app.js",
		"live": "nodemon app.js",
		"test": "mocha 'server/tests/test-apis.js' --timeout 10000 --exit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Kinshuk1993/books-collection-app.git"
	},
	"author": "Kinshuk Bhardwaj",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Kinshuk1993/books-collection-app/issues"
	},
	"homepage": "https://github.com/Kinshuk1993/books-collection-app#readme",
	"dependencies": {
		"express": "^4.21.2",
		"mongoose": "^8.19.2",
		"winston": "^3.18.3",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"chai": "^5.1.2",
		"chai-http": "^5.1.2",
		"mocha": "^10.8.2",
		"nodemon": "^3.1.10"
	}
}
