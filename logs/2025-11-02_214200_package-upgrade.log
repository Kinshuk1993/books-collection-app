[STEP 12] Convert All Test Cases to Async/Await
-------------------------------------------
File: E:\Kinshuk\Code\books-collection-app\server\tests\test-apis.js
Operation: Full rewrite
Timestamp: 21:45:00

Pattern Applied (42 test cases):
FROM (callback-based):
  it('test description', (done) => {
    new BooksDB(book).save((_err, book) => {
      chai.request(app)
        .post('/book')
        .send(book)
        .end((_err, res) => {
          res.should.have.status(201);
          done();
        });
    });
  });

TO (async/await):
  it('test description', async () => {
    const savedBook = await new BooksDB(book).save();
    const res = await chai.request(app)
      .post('/book')
      .send(book);
    res.should.have.status(201);
  });

